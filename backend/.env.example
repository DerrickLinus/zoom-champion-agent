# Copy this file to .env and fill in your own Alibaba Cloud Bailian key.
# Do not commit .env or put the key in the frontend.
DASHSCOPE_API_KEY=
ENABLE_BAILIAN=true
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
COSYVOICE_MODEL=cosyvoice-v1
COSYVOICE_VOICE=longxiaochun
BAILIAN_TIMEOUT_SECONDS=90
ASR_MODEL=paraformer-v2
